{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "labels": ["major"]
    },
    {
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "platformAutomerge": false,
      "labels": ["minor"]
    },
    {
      "matchUpdateTypes": ["patch"],
      "automerge": false,
      "platformAutomerge": false,
      "labels": ["patch"]
    }
  ]
}
